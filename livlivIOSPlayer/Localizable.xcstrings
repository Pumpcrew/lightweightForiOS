    "Gesture and bounce settings take effect the next time lip sync is turned on." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق إعدادات الإيماءات والقفز في المرة التالية التي يُشغَّل فيها مزامنة الشفاه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройките за жестове и подскачане важат от следващото включване на синхронизацията на устните."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অঙ্গভঙ্গি ও লাফানোর সেটিংস পরের বার লিপ সিঙ্ক চালু করলে প্রযোজ্য হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuració de gestos i saltironeig s’aplica la pròxima vegada que s’activi la sincronització labial."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení gest a poskakování se použije při příštím zapnutí synchronizace rtů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillingerne for fagter og hop gælder næste gang læbesynkronisering slås til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesten- und Hüpf-Einstellungen gelten ab dem nächsten Einschalten der Lippensynchronisation."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις χειρονομιών και αναπήδησης ισχύουν από την επόμενη ενεργοποίηση του συγχρονισμού χειλιών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de gestos y rebote se aplican la próxima vez que actives la sincronización labial."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de gestos y rebote se aplican la próxima vez que actives la sincronización labial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele- ja pomppuasetukset tulevat voimaan, kun huulisynkronointi seuraavan kerran laitetaan päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages de gestes et de rebond s’appliquent la prochaine fois que la synchronisation labiale est activée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages de gestes et de rebond s’appliquent la prochaine fois que la synchronisation labiale est activée."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હાવભાવ અને કૂદવાની સેટિંગ્સ આગલી વખતે લિપ સિંક ચાલુ કરતાં લાગુ થશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות המחוות והקפיצות יחולו בפעם הבאה שסנכרון השפתיים יופעל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाव-भाव और उछलने की सेटिंग्ज़ अगली बार लिप सिंक चालू करने पर लागू होंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavke gesta i poskakivanja primjenjuju se od sljedećeg uključivanja sinkronizacije usana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gesztus- és ugrálásbeállítások a szájszinkron következő bekapcsolásától érvényesek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan gestur dan lompatan berlaku saat sinkronisasi bibir dinyalakan berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni di gesti e saltelli si applicano dalla prossima attivazione del lip sync."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身ぶりと弾みの設定は、次にリップシンクをオンにしたときから反映されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ым-ишара және секіру параметрлері ерін синхрондауы келесі рет қосылғанда қолданылады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸನ್ನೆ ಮತ್ತು ಜಿಗಿತದ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮುಂದಿನ ಬಾರಿ ಲಿಪ್ ಸಿಂಕ್ ಆನ್ ಮಾಡಿದಾಗ ಅನ್ವಯವಾಗುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸짓과 튀기 설정은 다음에 립싱크를 켤 때부터 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestų ir pastryksėjimo nustatymai pradės veikti kitą kartą įjungus lūpų sinchronizavimą."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആംഗ്യ, ചാട്ട ക്രമീകരണങ്ങൾ അടുത്ത തവണ ലിപ് സിങ്ക് ഓണാക്കുമ്പോൾ ബാധകമാകും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हावभाव आणि उडीच्या सेटिंग्ज पुढच्या वेळी लिप सिंक सुरू केल्यावर लागू होतील."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seting gerak isyarat dan lompatan berkuat kuasa apabila penyegerakan bibir dihidupkan seterusnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillingene for gester og hopp gjelder neste gang leppesynk slås på."
          }
        },
