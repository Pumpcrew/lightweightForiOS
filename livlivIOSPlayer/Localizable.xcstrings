          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใน Finder ให้วางตัวละครไว้ในโฟลเดอร์ Documents ของแอปนี้ (โฟลเดอร์ตัวละครที่มี model.json และ textures/, ไฟล์ .livliv, .vrm หรือโฟลเดอร์ PNGTuber ที่มี closed.png และ open.png) จากนั้นเลือกที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
