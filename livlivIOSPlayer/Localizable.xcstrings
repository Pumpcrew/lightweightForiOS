    "Pick one from the Characters menu, or open one with Import." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر شخصية من قائمة الشخصيات أو افتح واحدة باستخدام استيراد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете герой от менюто „Герои“ или го отворете с „Импортиране“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চরিত্র মেনু থেকে একটি বেছে নিন বা ইমপোর্ট দিয়ে একটি খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria’n un al menú Personatges o obre’n un amb Importa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte postavu v nabídce Postavy, nebo ji otevřete přes Importovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en i menuen Figurer, eller åbn en med Importér."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine im Menü „Figuren“ oder öffne eine mit „Importieren“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε έναν από το μενού «Χαρακτήρες» ή ανοίξτε έναν με την «Εισαγωγή»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige uno en el menú Personajes o abre uno con Importar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige uno en el menú Personajes o abre uno con Importar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse hahmo Hahmot-valikosta tai avaa se Tuo-toiminnolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez-en un dans le menu Personnages, ou ouvrez-en un avec Importer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez-en un dans le menu Personnages, ou ouvrez-en un avec Importer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પાત્રો મેનૂમાંથી એક પસંદ કરો અથવા ઇમ્પોર્ટ કરો વડે એક ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר/י דמות בתפריט ״דמויות״ או פתח/י אחת באמצעות ״ייבוא״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैरेक्टर मेनू से एक चुनें या इंपोर्ट करें से एक खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite lik u izborniku Likovi ili ga otvorite pomoću Uvezi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon egyet a Karakterek menüben, vagy nyisson meg egyet az Importálással."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih karakter dari menu Karakter atau buka dengan Impor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegline uno dal menu Personaggi o aprine uno con Importa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャラクターメニューから選ぶか、読み込みで開いてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Кейіпкерлер» мәзірінен таңдаңыз немесе «Импорттау» арқылы ашыңыз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪಾತ್ರಗಳು ಮೆನುವಿನಿಂದ ಒಂದನ್ನು ಆರಿಸಿ ಅಥವಾ ಆಮದು ಮಾಡಿ ಮೂಲಕ ತೆರೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐릭터 메뉴에서 고르거나 가져오기로 여세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite personažą meniu „Personažai“ arba atidarykite jį per „Importuoti“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കഥാപാത്രങ്ങൾ മെനുവിൽ നിന്ന് ഒന്ന് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ ഇംപോർട്ട് ഉപയോഗിച്ച് തുറക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पात्रे मेनूमधून एक निवडा किंवा इंपोर्ट करा वापरून एक उघडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih watak daripada menu Watak atau buka dengan Import."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en i Figurer-menyen, eller åpne en med Importer."
