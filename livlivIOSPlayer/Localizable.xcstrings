        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଚରିତ୍ର ମେନୁରୁ ଗୋଟିଏ ବାଛନ୍ତୁ କିମ୍ବା ଇମ୍ପୋର୍ଟ କରନ୍ତୁ ଦ୍ୱାରା ଗୋଟିଏ ଖୋଲନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
